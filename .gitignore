# LaTeX build artifacts
*.aux
*.log
*.out
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# Internal working notes (not for distribution / double-blind)
_working_notes/

# Unused / legacy figures
figures/_unused/

# Large simulation data lives off-repo (regenerate via figures/gen_*.py; caches on local SSD)
*.npz
# ...but the small bundled reproduction caches under data/ ARE tracked, so a fresh
# clone can regenerate every figure without a GPU or any external download.
!data/**/*.npz
__pycache__/
*.pyc
